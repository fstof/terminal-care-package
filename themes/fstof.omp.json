{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": "\u256d\u2500",
          "foreground": "p:white",
          "trailing_diamond": "\ue0b0"
        },
        {
          "type": "os",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "cache": {
            "duration": "24h",
            "strategy": "session"
          },
          "foreground": "p:foreground",
          "background": "p:pink",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0"
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "p:black",
          "background": "p:orange",
          "template": " \uea83 {{ path .Path .Location }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "p:black",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:black{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:white{{ end }}",
            "{{ if gt .Ahead 0 }}p:white{{ end }}",
            "{{ if gt .Behind 0 }}p:white{{ end }}"
          ],
          "background": "p:green",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}p:selection{{ end }}",
            "{{ if gt .Behind 0 }}p:current-line{{ end }}"
          ],
          "template": " {{ .HEAD }}{{if .BranchStatus }}{{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044{{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046{{ .Staging.String }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}"
          }
        },
        {
          "type": "root",
          "style": "powerline",
          "foreground": "p:foreground",
          "background": "p:purple",
          "template": " \uf0e7 ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "status",
          "style": "diamond",
          "foreground": "p:black",
          "background": "p:cyan",
          "background_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "template": " {{ if gt .Code 0 }}\uf00d{{ else }}\uf00c{{ end }}",
          "leading_diamond": "<transparent,background>\ue0b0</>",
          "trailing_diamond": "\ue0b4",
          "options": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:purple",
          "background": "transparent",
          "template": "{{ .CurrentDate | date \"15:04:05\" }}"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \uf252 {{ .FormattedMs }} ",
          "options": {
            "always_enabled": true,
            "style": "austin"
          },
          "foreground": "p:pink",
          "background": "transparent"
        },
        {
          "type": "text",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\u2500\u256e",
          "foreground": "p:white",
          "background": "transparent"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\u2570\u2500",
          "foreground": "p:white"
        }
      ],
      "newline": true
    },
    {
      "type": "rprompt",
      "alignment": "left",
      "segments": [
        {
          "type": "flutter",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\ue7dd {{ .Full }}",
          "options": {
            "cache_duration": "5m"
          },
          "foreground": "p:blue",
          "background": "transparent"
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:green",
          "background": "transparent",
          "template": "\ue718 {{ .Full }}",
          "options": {
            "display_mode": "files",
            "fetch_package_manager": false,
            "home_enabled": false
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:yellow",
          "background": "transparent",
          "template": "\ue235 {{ .Full }}",
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          }
        },
        {
          "type": "text",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\u2500\u256f",
          "foreground": "p:white"
        }
      ],
      "force": false
    }
  ],
  "tooltips": [
    {
      "type": "git",
      "style": "plain",
      "tips": [
        "git",
        "g"
      ],
      "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }} ",
      "foreground": "#ffffff",
      "background": "#193549"
    }
  ],
  "transient_prompt": {
    "template": "<p:yellow,transparent>\ue0b6</><,p:yellow> {{ .Folder }} </><p:yellow,transparent>\ue0b0</> ",
    "foreground": "p:black",
    "background": "transparent"
  },
  "secondary_prompt": {
    "template": "<p:yellow,transparent>\ue0b6</><,p:yellow> > </><p:yellow,transparent>\ue0b0</> ",
    "foreground": "p:black",
    "background": "transparent"
  },
  "palette": {
    "black": "#282A36",
    "blue": "#4B95E9",
    "green": "#50FA7B",
    "orange": "#FFB86C",
    "red": "#FF5555",
    "white": "#F8F8F2",
    "yellow": "#F1FA8C",
    "cyan": "#8BE9FD",
    "purple": "#BD93F9",
    "pink": "#FF79C6",
    "background": "#282A36",
    "current-line": "#6272A4",
    "selection": "#44475A",
    "foreground": "#F8F8F2",
    "comment": "#6272A4"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  }
}
